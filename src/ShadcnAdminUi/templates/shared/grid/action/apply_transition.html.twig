{% from '@SyliusShadcnAdminUi/shared/helper/palette.html.twig' import tone %}

{% if workflow_can(data, action.name) %}
    {% if options.link.url is defined %}
        {% set path = options.link.url %}
    {% else %}
        {% set path = path(options.link.route, options.link.parameters|default({id: data.id})) %}
    {% endif %}

    {% set message = action.label|default('sylius.ui.apply_transition') %}
    {% set color = options.class|default('')|replace({'outline-': '', 'ghost-': ''}) %}
    {% set icon_attributes = {'aria-hidden': 'true'}|merge(color ? {class: tone(color, 'text')|trim} : {}) %}

    <form method="post" action="{{ path }}" class="inline-flex">
        <input type="hidden" name="_method" value="PATCH">
        <input type="hidden" name="_token" value="{{ csrf_token('apply_transition') }}">
        <twig:shadcn:Button type="submit" variant="ghost" size="icon-sm" title="{{ message|trans }}">
            {{ ux_icon(action.icon|default('lucide:arrow-right-left'), icon_attributes) }}
            <span class="sr-only">{{ message|trans }}</span>
        </twig:shadcn:Button>
    </form>
{% endif %}
