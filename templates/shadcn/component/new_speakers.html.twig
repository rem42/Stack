<twig:shadcn:Card>
    <twig:shadcn:Card:Header>
        <twig:shadcn:Card:Title>{{ 'app.ui.new_speakers'|trans }}</twig:shadcn:Card:Title>
        <twig:shadcn:Card:Action>
            <twig:shadcn:Button as="a" variant="outline" size="sm" href="{{ path('app_admin_speaker_index') }}">
                {{ 'app.ui.show_all'|trans }}
                <twig:ux:icon name="lucide:arrow-right" data-icon="inline-end" />
            </twig:shadcn:Button>
        </twig:shadcn:Card:Action>
    </twig:shadcn:Card:Header>
    <twig:shadcn:Card:Content>
        <twig:shadcn:Item:Group>
            {% for speaker in new_speakers|default([]) %}
                <twig:shadcn:Item size="sm">
                    <twig:shadcn:Item:Media>
                        <twig:shadcn:Avatar>
                            {% if speaker.avatar %}
                                <twig:shadcn:Avatar:Image src="{{ vich_uploader_asset(speaker.avatar) }}" />
                            {% endif %}
                            <twig:shadcn:Avatar:Fallback>{{ speaker.firstName|first }}{{ speaker.lastName|first }}</twig:shadcn:Avatar:Fallback>
                        </twig:shadcn:Avatar>
                    </twig:shadcn:Item:Media>
                    <twig:shadcn:Item:Content>
                        <twig:shadcn:Item:Title>{{ speaker.fullName }}</twig:shadcn:Item:Title>
                        <twig:shadcn:Item:Description>{{ speaker.companyName }}</twig:shadcn:Item:Description>
                    </twig:shadcn:Item:Content>
                </twig:shadcn:Item>
            {% endfor %}
        </twig:shadcn:Item:Group>
    </twig:shadcn:Card:Content>
</twig:shadcn:Card>
